# Copy to .env.local. Never commit .env.local or paste credentials into chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# openai: real API; mock: deterministic offline prototype. With no override,
# a configured key selects OpenAI and a missing key selects labeled mock mode.
RAVENLAND_AI_MODE=openai
OPENAI_MAX_OUTPUT_TOKENS=2400
OPENAI_TIMEOUT_MS=90000
# Optional per-million-token USD prices for the selected model. Leave blank if
# unknown. Estimates do not include tools, taxes or provider-side discounts.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
# Separate, LOCAL DEVELOPMENT ONLY gate for privileged memory review and scene
# sharing. Use a random secret of at least 24 characters. Not an OpenAI key.
# Replace with authenticated campaign roles before any multiplayer hosting.
RAVENLAND_GM_REVIEW_TOKEN=

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forbidden Lands Character Sheet SPA</title>
    <style>
        :root {
            --bg-color: #121212;
            --panel-bg: #1e1e1e;
            --accent-color: #8b0000;
            --accent-hover: #a00000;
            --gold-color: #d4af37;
            --text-color: #e0e0e0;
            --border-color: #333;
            --input-bg: #2a2a2a;
        }

        body {
            font-family: 'Times New Roman', Times, serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: 15px;
        }

        .panel {
            background-color: var(--panel-bg);
            border: 1px solid var(--border-color);
            border-radius: 4px;
            padding: 15px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        }

        h2, h3 {
            margin-top: 0;
            color: var(--gold-color);
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .col-12 { grid-column: span 12; }
        .col-8 { grid-column: span 8; }
        .col-6 { grid-column: span 6; }
        .col-4 { grid-column: span 4; }
        .col-3 { grid-column: span 3; }

        @media (max-width: 768px) {
            .col-8, .col-6, .col-4, .col-3 { grid-column: span 12; }
        }

        label {
            display: block;
            margin-bottom: 3px;
            font-size: 0.85em;
            text-transform: uppercase;
            color: #aaa;
        }

        input[type="text"], input[type="number"], select, textarea {
            width: 100%;
            background-color: var(--input-bg);
            border: 1px solid var(--border-color);
            color: var(--text-color);
            padding: 8px;
            border-radius: 3px;
            box-sizing: border-box;
            font-family: inherit;
        }

        textarea {
            resize: vertical;
            height: 60px;
        }

        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 5px; }
        .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }

        .attr-box {
            text-align: center;
            background: #252525;
            padding: 8px;
            border-radius: 4px;
            border: 1px solid #3a3a3a;
        }

        .attr-box input {
            text-align: center;
            font-size: 1.2em;
            font-weight: bold;
        }

        .skill-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px;
            font-size: 0.9em;
        }

        .skill-row input {
            width: 50px;
            text-align: center;
        }

        .resource-box {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        .resource-box select { width: 80px; }

        .checkbox-group {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 5px;
        }

        .checkbox-group label {
            display: flex;
            align-items: center;
            gap: 5px;
            cursor: pointer;
            color: var(--text-color);
            text-transform: none;
        }

        button {
            background-color: var(--accent-color);
            color: white;
            border: none;
            padding: 8px 12px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            text-transform: uppercase;
        }

        button:hover { background-color: var(--accent-hover); }

        .btn-add { margin-top: 10px; width: 100%; }
        .btn-roll {
            background-color: #2e5a2e;
            padding: 4px 8px;
            font-size: 0.8em;
            margin-left: 5px;
        }
        .btn-roll:hover { background-color: #3b7a3b; }

        .dynamic-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 5px;
        }

        .dynamic-table th, .dynamic-table td {
            border: 1px solid var(--border-color);
            padding: 4px;
            text-align: left;
            font-size: 0.85em;
        }

        .btn-del { background: #444; padding: 2px 6px; font-size: 0.8em; }
        .btn-del:hover { background: #a00000; }

        /* Dice Log & Modal Styling */
        #dice-panel {
            background: #181818;
            border: 1px solid var(--gold-color);
        }

        .dice-container {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin: 10px 0;;
        }

        .die {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 1.1em;
            border-radius: 4px;
            color: white;
            border: 1px solid #000;
        }

        .die-base { background-color: #f5f5f5; color: #111; }
        .die-skill { background-color: #8b0000; color: #fff; }
        .die-gear { background-color: #222; color: #fff; border-color: #555; }
        .die-artifact { background-color: #d4af37; color: #111; }

        .die-success { border: 2px solid #00ff00; box-shadow: 0 0 5px #00ff00; }
        .die-bane { border: 2px solid #ff0000; box-shadow: 0 0 5px #ff0000; }

        .controls-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>

<div class="container">

    <!-- Top Management Bar -->
    <div class="panel col-12">
        <div class="controls-bar">
            <div>
                <label style="display:inline-block; margin-right: 5px;">Active Roster:</label>
                <select id="character-select" onchange="app.switchCharacter(this.value)" style="width: 200px; display:inline-block;"></select>
                <button onclick="app.createNewCharacter()">+ New</button>
                <button onclick="app.deleteCharacter()" style="background-color: #444;">Delete</button>
            </div>
            <div>
                <button onclick="app.exportJSON()">Export JSON</button>
                <button onclick="document.getElementById('import-file').click()">Import JSON</button>
                <input type="file" id="import-file" style="display:none" onchange="app.importJSON(event)">
            </div>
        </div>
    </div>

    <!-- Dice Roller Output Panel -->
    <div class="panel col-12" id="dice-panel">
        <h3>Dice Roller Console</h3>
        <div id="dice-summary" style="font-size: 0.95em; color: #aaa;">Select a Skill or Weapon to roll...</div>
        <div class="dice-container" id="dice-results"></div>
        <div id="dice-actions">
            <button id="btn-push" onclick="app.pushRoll()" style="display:none; background-color: #d4af37; color: #111;">Push Roll!</button>
        </div>
    </div>

    <!-- Header / Basic Info -->
    <div class="panel col-12">
        <h2>Forbidden Lands Adventurer</h2>
        <div class="grid-4">
            <div>
                <label>Name</label>
                <input type="text" id="name" onchange="app.saveState()">
            </div>
            <div>
                <label>Kin</label>
                <select id="kin" onchange="app.saveState()">
                    <option>Human</option><option>Elf</option><option>Half-Elf</option><option>Dwarf</option>
                    <option>Halfling</option><option>Wolfkin</option><option>Orc</option><option>Goblin</option>
                </select>
            </div>
            <div>
                <label>Profession</label>
                <select id="profession" onchange="app.saveState()">
                    <option>Druid</option><option>Fighter</option><option>Hunter</option><option>Minstrel</option>
                    <option>Peddler</option><option>Rider</option><option>Rogue</option><option>Sorcerer</option>
                </select>
            </div>
            <div>
                <label>Age</label>
                <select id="age" onchange="app.saveState()">
                    <option>Young</option><option>Adult</option><option>Old</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Attributes & Trackers -->
    <div class="panel col-4">
        <h3>Attributes</h3>
        <div class="grid-2">
            <div class="attr-box">
                <label>Strength</label>
                <input type="number" id="attr-strength" min="0" max="6" value="2" onchange="app.saveState()">
            </div>
            <div class="attr-box">
                <label>Agility</label>
                <input type="number" id="attr-agility" min="0" max="6" value="2" onchange="app.saveState()">
            </div>
            <div class="attr-box">
                <label>Wits</label>
                <input type="number" id="attr-wits" min="0" max="6" value="2" onchange="app.saveState()">
            </div>
            <div class="attr-box">
                <label>Empathy</label>
                <input type="number" id="attr-empathy" min="0" max="6" value="2" onchange="app.saveState()">
            </div>
        </div>

        <h3 style="margin-top: 15px;">Pools & Trackers</h3>
        <div class="grid-2">
            <div>
                <label>Willpower (Max 10)</label>
                <input type="number" id="willpower" min="0" max="10" value="0" onchange="app.saveState()">
            </div>
            <div>
                <label>Experience (XP)</label>
                <input type="number" id="xp" min="0" value="0" onchange="app.saveState()">
            </div>
            <div>
                <label>Reputation</label>
                <input type="number" id="reputation" min="0" value="0" onchange="app.saveState()">
            </div>
            <div>
                <label>Armor Rating</label>
                <input type="number" id="armor-rating" min="0" value="0" onchange="app.saveState()">
            </div>
        </div>

        <h3 style="margin-top: 15px;">Conditions</h3>
        <div class="checkbox-group">
            <label><input type="checkbox" id="cond-hungry" onchange="app.saveState()"> Hungry</label>
            <label><input type="checkbox" id="cond-thirsty" onchange="app.saveState()"> Thirsty</label>
            <label><input type="checkbox" id="cond-sleepy" onchange="app.saveState()"> Sleepy</label>
            <label><input type="checkbox" id="cond-cold" onchange="app.saveState()"> Cold</label>
        </div>
    </div>

    <!-- Skills -->
    <div class="panel col-4">
        <h3>Skills</h3>
        <div id="skills-list"></div>
    </div>

    <!-- Personal Details -->
    <div class="panel col-4">
        <h3>Personal Details</h3>
        <div style="margin-bottom: 8px;">
            <label>Pride</label>
            <input type="text" id="pride" onchange="app.saveState()">
        </div>
        <div style="margin-bottom: 8px;">
            <label>Dark Secret</label>
            <input type="text" id="dark-secret" onchange="app.saveState()">
        </div>
        <div style="margin-bottom: 8px;">
            <label>Relationships</label>
            <textarea id="relationships" onchange="app.saveState()"></textarea>
        </div>
        <div style="margin-bottom: 8px;">
            <label>Appearance</label>
            <textarea id="appearance" onchange="app.saveState()"></textarea>
        </div>
        <div>
            <label>Critical Injuries</label>
            <textarea id="critical-injuries" onchange="app.saveState()"></textarea>
        </div>
    </div>

    <!-- Consumables & Purse -->
    <div class="panel col-4">
        <h3>Consumables & Purse</h3>
        <div class="resource-box">
            <label>Food</label>
            <select id="res-food" onchange="app.saveState()"><option>None</option><option>D6</option><option>D8</option><option>D10</option><option>D12</option></select>
        </div>
        <div class="resource-box">
            <label>Water</label>
            <select id="res-water" onchange="app.saveState()"><option>None</option><option>D6</option><option>D8</option><option>D10</option><option>D12</option></select>
        </div>
        <div class="resource-box">
            <label>Arrows</label>
            <select id="res-arrows" onchange="app.saveState()"><option>None</option><option>D6</option><option>D8</option><option>D10</option><option>D12</option></select>
        </div>
        <div class="resource-box">
            <label>Torches</label>
            <select id="res-torches" onchange="app.saveState()"><option>None</option><option>D6</option><option>D8</option><option>D10</option><option>D12</option></select>
        </div>
        <hr style="border-color: var(--border-color); margin: 10px 0;">
        <div class="grid-3">
            <div><label>Copper</label><input type="number" id="coin-copper" min="0" value="0" onchange="app.saveState()"></div>
            <div><label>Silver</label><input type="number" id="coin-silver" min="0" value="0" onchange="app.saveState()"></div>
            <div><label>Gold</label><input type="number" id="coin-gold" min="0" value="0" onchange="app.saveState()"></div>
        </div>
    </div>

    <!-- Talents Table -->
    <div class="panel col-8">
        <h3>Talents</h3>
        <table class="dynamic-table" id="talents-table">
            <thead>
                <tr>
                    <th>Talent Name</th>
                    <th style="width: 60px;">Rank</th>
                    <th>Description</th>
                    <th style="width: 30px;"></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
        <button class="btn-add" onclick="app.addTalentRow()">+ Add Talent</button>
    </div>

    <!-- Weapons Table -->
    <div class="panel col-6">
        <h3>Weapons</h3>
        <table class="dynamic-table" id="weapons-table">
            <thead>
                <tr>
                    <th>Weapon</th>
                    <th style="width: 50px;">Bonus</th>
                    <th style="width: 50px;">Dmg</th>
                    <th style="width: 60px;">Range</th>
                    <th>Features</th>
                    <th style="width: 80px;">Roll</th>
                    <th style="width: 30px;"></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
        <button class="btn-add" onclick="app.addWeaponRow()">+ Add Weapon</button>
    </div>

    <!-- Gear Table -->
    <div class="panel col-6">
        <h3>Gear</h3>
        <table class="dynamic-table" id="gear-table">
            <thead>
                <tr>
                    <th>Item</th>
                    <th style="width: 80px;">Weight</th>
                    <th>Notes</th>
                    <th style="width: 30px;"></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
        <button class="btn-add" onclick="app.addGearRow()">+ Add Gear</button>
    </div>

</div>

<script>
/**
 * Forbidden Lands Character Sheet Single Page Application
 */
class ForbiddenLandsApp {
    constructor() {
        this.skillsConfig = [
            { id: 'might', name: 'Might', attr: 'strength' },
            { id: 'endurance', name: 'Endurance', attr: 'strength' },
            { id: 'melee', name: 'Melee', attr: 'strength' },
            { id: 'crafting', name: 'Crafting', attr: 'strength' },
            { id: 'stealth', name: 'Stealth', attr: 'agility' },
            { id: 'sleightofhand', name: 'Sleight of Hand', attr: 'agility' },
            { id: 'move', name: 'Move', attr: 'agility' },
            { id: 'marksmanship', name: 'Marksmanship', attr: 'agility' },
            { id: 'scouting', name: 'Scouting', attr: 'wits' },
            { id: 'lore', name: 'Lore', attr: 'wits' },
            { id: 'survival', name: 'Survival', attr: 'wits' },
            { id: 'insight', name: 'Insight', attr: 'wits' },
            { id: 'manipulation', name: 'Manipulation', attr: 'empathy' },
            { id: 'performance', name: 'Performance', attr: 'empathy' },
            { id: 'healing', name: 'Healing', attr: 'empathy' },
            { id: 'animalhandling', name: 'Animal Handling', attr: 'empathy' }
        ];

        this.fieldIds = [
            'name', 'kin', 'profession', 'age',
            'attr-strength', 'attr-agility', 'attr-wits', 'attr-empathy',
            'willpower', 'xp', 'reputation', 'armor-rating',
            'cond-hungry', 'cond-thirsty', 'cond-sleepy', 'cond-cold',
            'pride', 'dark-secret', 'relationships', 'appearance', 'critical-injuries',
            'res-food', 'res-water', 'res-arrows', 'res-torches',
            'coin-copper', 'coin-silver', 'coin-gold'
        ];

        this.currentRoll = null;
        this.activeCharId = null;
        this.roster = {};
    }

    init() {
        this.renderSkills();
        this.loadRoster();
        if (Object.keys(this.roster).length === 0) {
            this.createNewCharacter();
        } else {
            this.activeCharId = Object.keys(this.roster)[0];
            this.loadCharacter(this.activeCharId);
        }
        this.updateRosterSelect();
    }

    renderSkills() {
        const container = document.getElementById('skills-list');
        container.innerHTML = '';
        this.skillsConfig.forEach(skill => {
            const div = document.createElement('div');
            div.className = 'skill-row';
            div.innerHTML = `
                <label>${skill.name} (${skill.attr.substring(0,3).toUpperCase()})</label>
                <div>
                    <input type="number" id="skill-${skill.id}" min="0" max="5" value="0" onchange="app.saveState()">
                    <button class="btn-roll" onclick="app.rollSkill('${skill.id}')">Roll</button>
                </div>
            `;
            container.appendChild(div);
        });
    }

    // --- Roster & Storage Management ---
    loadRoster() {
        const raw = localStorage.getItem('fbl_roster_v1');
        if (raw) {
            try { this.roster = JSON.parse(raw); } catch(e) { this.roster = {}; }
        }
    }

    saveRoster() {
        localStorage.setItem('fbl_roster_v1', JSON.stringify(this.roster));
        this.updateRosterSelect();
    }

    updateRosterSelect() {
        const select = document.getElementById('character-select');
        select.innerHTML = '';
        Object.keys(this.roster).forEach(id => {
            const opt = document.createElement('option');
            opt.value = id;
            opt.textContent = this.roster[id].name || 'Unnamed Adventurer';
            if (id === this.activeCharId) opt.selected = true;
            select.appendChild(opt);
        });
    }

    createNewCharacter() {
        const id = 'char_' + Date.now();
        this.roster[id] = { name: 'New Adventurer' };
        this.activeCharId = id;
        this.saveRoster();
        this.resetForm();
        this.saveState();
    }

    deleteCharacter() {
        if (Object.keys(this.roster).length <= 1) {
            alert('Cannot delete the last character profile.');
            return;
        }
        if (confirm('Are you sure you want to delete this character?')) {
            delete this.roster[this.activeCharId];
            this.activeCharId = Object.keys(this.roster)[0];
            this.saveRoster();
            this.loadCharacter(this.activeCharId);
        }
    }

    switchCharacter(id) {
        this.saveState();
        this.activeCharId = id;
        this.loadCharacter(id);
    }

    resetForm() {
        this.fieldIds.forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                if (el.type === 'checkbox') el.checked = false;
                else if (el.type === 'number') el.value = el.min || 0;
                else el.value = '';
            }
        });
        this.skillsConfig.forEach(s => {
            document.getElementById(`skill-${s.id}`).value = 0;
        });
        document.querySelector('#talents-table tbody').innerHTML = '';
        document.querySelector('#weapons-table tbody').innerHTML = '';
        document.querySelector('#gear-table tbody').innerHTML = '';
        this.addTalentRow('Kin Talent', 1, '');
        this.addWeaponRow('Dagger', 1, 1, 'Arm', 'Light, Pointed');
    }

    saveState() {
        if (!this.activeCharId) return;
        const data = {};
        
        this.fieldIds.forEach(id => {
            const el = document.getElementById(id);
            if (el) data[id] = el.type === 'checkbox' ? el.checked : el.value;
        });

        this.skillsConfig.forEach(s => {
            data[`skill-${s.id}`] = document.getElementById(`skill-${s.id}`).value;
        });

        data.talents = Array.from(document.querySelectorAll('#talents-table tbody tr')).map(tr => ({
            name: tr.querySelector('.t-name').value,
            rank: tr.querySelector('.t-rank').value,
            desc: tr.querySelector('.t-desc').value
        }));

        data.weapons = Array.from(document.querySelectorAll('#weapons-table tbody tr')).map(tr => ({
            name: tr.querySelector('.w-name').value,
            bonus: tr.querySelector('.w-bonus').value,
            dmg: tr.querySelector('.w-dmg').value,
            range: tr.querySelector('.w-range').value,
            feat: tr.querySelector('.w-feat').value
        }));

        data.gear = Array.from(document.querySelectorAll('#gear-table tbody tr')).map(tr => ({
            item: tr.querySelector('.g-item').value,
            weight: tr.querySelector('.g-weight').value,
            notes: tr.querySelector('.g-notes').value
        }));

        this.roster[this.activeCharId] = data;
        this.saveRoster();
    }

    loadCharacter(id) {
        const data = this.roster[id];
        if (!data) return;

        this.fieldIds.forEach(fid => {
            const el = document.getElementById(fid);
            if (el && data[fid] !== undefined) {
                if (el.type === 'checkbox') el.checked = data[fid];
                else el.value = data[fid];
            }
        });

        this.skillsConfig.forEach(s => {
            const el = document.getElementById(`skill-${s.id}`);
            if (el && data[`skill-${s.id}`] !== undefined) el.value = data[`skill-${s.id}`];
        });

        document.querySelector('#talents-table tbody').innerHTML = '';
        if (data.talents) data.talents.forEach(t => this.addTalentRow(t.name, t.rank, t.desc));

        document.querySelector('#weapons-table tbody').innerHTML = '';
        if (data.weapons) data.weapons.forEach(w => this.addWeaponRow(w.name, w.bonus, w.dmg, w.range, w.feat));

        document.querySelector('#gear-table tbody').innerHTML = '';
        if (data.gear) data.gear.forEach(g => this.addGearRow(g.item, g.weight, g.notes));
    }

    // --- Dynamic Table Adders ---
    addTalentRow(name = '', rank = 1, desc = '') {
        this.createTableRow('talents-table', [
            `<input type="text" value="${name}" class="t-name" onchange="app.saveState()">`,
            `<input type="number" value="${rank}" min="1" max="3" class="t-rank" onchange="app.saveState()">`,
            `<input type="text" value="${desc}" class="t-desc" onchange="app.saveState()">`
        ]);
    }

    addWeaponRow(name = '', bonus = 0, dmg = 1, range = 'Arm', feat = '') {
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td><input type="text" value="${name}" class="w-name" onchange="app.saveState()"></td>
            <td><input type="number" value="${bonus}" class="w-bonus" onchange="app.saveState()"></td>
            <td><input type="number" value="${dmg}" class="w-dmg" onchange="app.saveState()"></td>
            <td><input type="text" value="${range}" class="w-range" onchange="app.saveState()"></td>
            <td><input type="text" value="${feat}" class="w-feat" onchange="app.saveState()"></td>
            <td><button class="btn-roll" onclick="app.rollWeaponAttack(this)">Attack</button></td>
            <td><button class="btn-del" onclick="this.closest('tr').remove(); app.saveState();">X</button></td>
        `;
        document.querySelector('#weapons-table tbody').appendChild(tr);
    }

    addGearRow(item = '', weight = 'Normal', notes = '') {
        this.createTableRow('gear-table', [
            `<input type="text" value="${item}" class="g-item" onchange="app.saveState()">`,
            `<select class="g-weight" onchange="app.saveState()">
                <option ${weight==='Tiny'?'selected':''}>Tiny</option>
                <option ${weight==='Light'?'selected':''}>Light</option>
                <option ${weight==='Normal'?'selected':''}>Normal</option>
                <option ${weight==='Heavy'?'selected':''}>Heavy</option>
            </select>`,
            `<input type="text" value="${notes}" class="g-notes" onchange="app.saveState()">`
        ]);
    }

    createTableRow(tableId, cellHTMLs) {
        const tr = document.createElement('tr');
        cellHTMLs.forEach(html => {
            const td = document.createElement('td');
            td.innerHTML = html;
            tr.appendChild(td);
        });
        const delTd = document.createElement('td');
        delTd.innerHTML = `<button class="btn-del" onclick="this.closest('tr').remove(); app.saveState();">X</button>`;
        tr.appendChild(delTd);
        document.querySelector(`#${tableId} tbody`).appendChild(tr);
    }

    // --- Dice Engine ---
    rollDice(baseCount, skillCount, gearCount) {
        const rollArray = (count, type) => {
            let dice = [];
            for (let i = 0; i < count; i++) {
                let val = Math.floor(Math.random() * 6) + 1;
                dice.push({ value: val, type: type, pushed: false });
            }
            return dice;
        };

        return [
            ...rollArray(baseCount, 'base'),
            ...rollArray(skillCount, 'skill'),
            ...rollArray(gearCount, 'gear')
        ];
    }

    rollSkill(skillId) {
        const config = this.skillsConfig.find(s => s.id === skillId);
        const attrVal = parseInt(document.getElementById(`attr-${config.attr}`).value) || 0;
        const skillVal = parseInt(document.getElementById(`skill-${skillId}`).value) || 0;

        const dice = this.rollDice(attrVal, skillVal, 0);
        this.currentRoll = { label: config.name, dice: dice, isPushed: false };
        this.renderRollResults();
    }

    rollWeaponAttack(btn) {
        const tr = btn.closest('tr');
        const wName = tr.querySelector('.w-name').value;
        const wBonus = parseInt(tr.querySelector('.w-bonus').value) || 0;
        const meleeVal = parseInt(document.getElementById('skill-melee').value) || 0;
        const strVal = parseInt(document.getElementById('attr-strength').value) || 0;

        const dice = this.rollDice(strVal, meleeVal, wBonus);
        this.currentRoll = { label: `Attack: ${wName}`, dice: dice, isPushed: false };
        this.renderRollResults();
    }

    pushRoll() {
        if (!this.currentRoll || this.currentRoll.isPushed) return;

        let baseBanes = 0;
        let gearBanes = 0;

        this.currentRoll.dice.forEach(die => {
            // Successes and banes stay locked
            if (die.value === 6) return;
            if (die.value === 1 && die.type !== 'skill') {
                if (die.type === 'base') baseBanes++;
                if (die.type === 'gear') gearBanes++;
                return;
            }
            // Reroll eligible dice
            die.value = Math.floor(Math.random() * 6) + 1;
            die.pushed = true;

            if (die.value === 1 && die.type === 'base') baseBanes++;
            if (die.value === 1 && die.type === 'gear') gearBanes++;
        });

        this.currentRoll.isPushed = true;

        // Apply pushed banes to Willpower automatic tracking
        if (baseBanes > 0) {
            const wpInput = document.getElementById('willpower');
            let currentWP = parseInt(wpInput.value) || 0;
            wpInput.value = Math.min(10, currentWP + baseBanes);
            this.saveState();
        }

        this.renderRollResults(baseBanes, gearBanes);
    }

    renderRollResults(baseBanes = 0, gearBanes = 0) {
        const container = document.getElementById('dice-results');
        const summary = document.getElementById('dice-summary');
        const actions = document.getElementById('dice-actions');
        container.innerHTML = '';

        let successes = 0;
        this.currentRoll.dice.forEach(d => {
            if (d.value === 6) successes++;
            const el = document.createElement('div');
            let typeClass = `die-${d.type}`;
            let statusClass = d.value === 6 ? 'die-success' : (d.value === 1 && d.type !== 'skill' ? 'die-banes' : '');
            el.className = `die ${typeClass} ${statusClass}`;
            el.textContent = d.value === 6 ? '⚔️' : (d.value === 1 && d.type !== 'skill' ? '💀' : d.value);
            container.appendChild(el);
        });

        let text = `<strong>${this.currentRoll.label}</strong>: ${successes} Success(es) [⚔️]`;
        if (this.currentRoll.isPushed) {
            text += ` | <em>Pushed!</em> (${baseBanes} Base Baned 💀 -> +${baseBanes} WP gained, ${gearBanes} Gear Damaged)`;
            document.getElementById('btn-push').style.display = 'none';
        } else {
            document.getElementById('btn-push').style.display = 'inline-block';
        }
        summary.innerHTML = text;
    }

    // --- Import / Export ---
    exportJSON() {
        this.saveState();
        const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(this.roster[this.activeCharId], null, 2));
        const dlAnchor = document.createElement('a');
        dlAnchor.setAttribute("href", dataStr);
        dlAnchor.setAttribute("download", `${this.roster[this.activeCharId].name || 'character'}_sheet.json`);
        document.body.appendChild(dlAnchor);
        dlAnchor.click();
        dlAnchor.remove();
    }

    importJSON(event) {
        const reader = new FileReader();
        reader.onload = (e) => {
            try {
                const data = JSON.parse(e.target.result);
                const id = 'char_' + Date.now();
                this.roster[id] = data;
                this.activeCharId = id;
                this.saveRoster();
                this.loadCharacter(id);
            } catch(err) {
                alert('Invalid JSON character file.');
            }
        };
        reader.readAsText(event.target.files[0]);
    }
}

// Instantiate App
const app = new ForbiddenLandsApp();
window.addEventListener('DOMContentLoaded', () => app.init());
</script>
